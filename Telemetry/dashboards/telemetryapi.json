{
  "uid": "telemetryapi",
  "title": "TelemetryApi - kunder",
  "description": "RED-metrics, egna metrics, traces och loggar för TelemetryApi.",
  "tags": [
    "kvällskurs",
    "telemetryapi"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
