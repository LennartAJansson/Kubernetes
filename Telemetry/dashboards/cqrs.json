    {
      "type": "table",
      "title": "Kommandon - en trace från klick till databas",
      "description": "Öppna en trace: cqrs-client → cqrs-api → NATS → cqrs-worker → INSERT/UPDATE.",
      "id": 47,
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"cqrs-worker\" && span.cqrs.command_id != nil }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {},
