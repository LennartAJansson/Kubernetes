{
  "uid": "telemetri-oversikt",
  "title": "Telemetri - översikt",
  "description": "Beviset: metrics, traces och loggar från alla appar i en vy.",
  "tags": [
    "kvällskurs",
    "översikt"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
